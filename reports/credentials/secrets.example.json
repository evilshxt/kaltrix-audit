{
  "engagement": "kaltrixos-security-audit",
  "target": "https://kaltrixos.com/",
  "secrets": [
    {
      "id": "SEC-001",
      "type": "supabase_project_url",
      "variable_name_convention": "NEXT_PUBLIC_SUPABASE_URL",
      "value": "https://<project-ref>.supabase.co"
    },
    {
      "id": "SEC-002",
      "type": "supabase_anon_key",
      "variable_name_convention": "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "value": "<live-anon-key>",
      "role": "anon"
    }
  ],
  "notes": "Local template. Copy to secrets.json, fill in the authorized project URL and current anon key, and never commit the filled file."
}
